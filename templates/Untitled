<!DOCTYPE html><html lang="en"><head>
<meta charset="utf-8">
<meta content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no, viewport-fit=cover" name="viewport">
<meta content="mobile_blank" name="shell-type">
<link href="https://fonts.googleapis.com" rel="preconnect">
<link crossorigin="" href="https://fonts.gstatic.com" rel="preconnect">
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&amp;family=Plus+Jakarta+Sans:wght@600;700;800&amp;display=swap" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=Material+Symbols+Outlined:wght,FILL@100..700,0..1&amp;display=swap" rel="stylesheet">
<style>
    @layer base {
      html, body {
        width: 100%;
        margin: 0;
        padding: 0;
      }
      body {
        overscroll-behavior: none;
      }
      .pb-safe {
        padding-bottom: env(safe-area-inset-bottom, 0px);
      }
      .pt-safe {
        padding-top: env(safe-area-inset-top, 0px);
      }
    }
    ::-webkit-scrollbar {
      display: none;
    }
  </style>
<script src="https://cdn.tailwindcss.com?plugins=forms,container-queries"></script>
<script id="tailwind-config">
    tailwind.config = {
      darkMode: "class",
      theme: {
        extend: {
          colors: {
            "surface-container-highest": "#e2e2e3",
            "surface-container": "#eeeeef",
            "on-background": "#1a1c1d",
            "secondary": "#006a61",
            "on-primary-fixed": "#24005b",
            "on-error": "#ffffff",
            "on-primary-container": "#fffbff",
            "background": "#f8f9fa",
            "surface": "#f8f9fa",
            "primary": "#6c39d0",
            "primary-container": "#8556eb",
            "error": "#d92d20",
            "error-container": "#fee4e2",
            "on-error-container": "#912018",
            "surface-container-lowest": "#ffffff",
            "outline-variant": "#e4e7ec",
            "on-surface": "#101828",
            "on-surface-variant": "#475467"
          },
          fontFamily: {
            "title-md": ["Plus Jakarta Sans", "sans-serif"],
            "body-md": ["Inter", "sans-serif"],
            "body-sm": ["Inter", "sans-serif"],
            "label-md": ["Inter", "sans-serif"],
            "headline-md": ["Plus Jakarta Sans", "sans-serif"],
            "label-sm": ["Inter", "sans-serif"],
            "headline-sm": ["Plus Jakarta Sans", "sans-serif"],
            "label-lg": ["Inter", "sans-serif"]
          }
        }
      }
    };
  </script>
<style>
    body {
      min-height: max(884px, 100dvh);
    }
  </style>
</head>
<body class="bg-[#f2f4f7] text-[#101828] font-body-md text-sm pt-safe pb-safe min-h-screen flex flex-col justify-start items-center" data-gr-ext-go-mode="">
<main class="w-full max-w-[620px] px-3 sm:px-4 py-4 sm:py-6 flex flex-col gap-4">
<!-- 1. TOP ROW: Centered Swago Logo & INVENTORY SYSTEM Tag -->
<header class="w-full bg-white rounded-2xl shadow-sm border border-gray-100/80 px-4 py-3.5 flex flex-col items-center justify-center gap-1.5"><div class="flex items-center justify-center h-11"><span class="font-headline-md text-2xl font-extrabold tracking-tight flex items-center"><span style="color: #f750ae;">S</span><span style="color: #42a7eb;">W</span><span style="color: #f8c630;">A</span><span style="color: #3ee0cf;">G</span><span style="color: #f78d50;">O</span><span class="ml-1.5" style="color: #8859ee;">Jr.</span></span></div><div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-[#1e293b] text-white text-[10px] font-bold tracking-widest uppercase"><span class="w-1.5 h-1.5 rounded-full bg-[#3ee0cf] animate-pulse"></span>INVENTORY SYSTEM</div></header>
<!-- 2. ALERT HERO BANNER: High-impact urgent card -->
<section class="w-full rounded-2xl overflow-hidden bg-white shadow-sm border border-red-100 flex flex-col">
<!-- Gradient Red Alert Bar -->
<div class="bg-gradient-to-r from-[#d92d20] to-[#e63946] text-white px-5 py-5 sm:px-6 flex flex-col items-center text-center gap-2">
<div class="w-11 h-11 rounded-full bg-white/20 backdrop-blur-sm flex items-center justify-center shadow-inner">
<span class="text-xl">⚠️</span>
</div>
<h1 class="font-headline-md text-xl sm:text-2xl font-bold tracking-tight text-white flex items-center gap-1.5">
          Low Stock Alert
        </h1>
<p class="text-xs sm:text-sm text-red-50/95 max-w-[420px] font-normal leading-relaxed">
          Inventory items have fallen below their low-stock threshold
        </p>
</div>
<!-- Item Counter Badge Row -->
<div class="bg-red-50/70 border-t border-b border-red-100/80 px-4 py-2.5 flex items-center justify-center gap-2 text-center">
<span class="inline-flex items-center justify-center px-2 py-0.5 rounded-md bg-[#d92d20] text-white font-bold text-xs shadow-xs">
          2
        </span>
<span class="text-xs sm:text-sm font-medium text-red-900">
          items need replenishment attention
        </span>
</div>
<!-- 3. INVENTORY TABLE CARD (Clean modern e-commerce data grid) -->
<div class="p-4 sm:p-5 flex flex-col gap-3">
<div class="w-full rounded-xl border border-gray-200/90 overflow-hidden bg-white">
<div class="overflow-x-auto">
<table class="w-full text-left border-collapse min-w-[500px]">
<thead>
<tr class="bg-gray-50/90 border-b border-gray-200 text-gray-500 text-[11px] font-semibold tracking-wider uppercase">
<th class="py-2.5 px-3.5">ITEM</th>
<th class="py-2.5 px-3">SKU</th>
<th class="py-2.5 px-3 text-center">STOCK</th>
<th class="py-2.5 px-3 text-center">THRESHOLD</th>
<th class="py-2.5 px-3 text-right">UNIT</th>
</tr>
</thead>
<tbody class="divide-y divide-gray-100 text-xs">
<!-- Item 1 -->
<tr class="hover:bg-gray-50/50 transition-colors">
<td class="py-3 px-3.5 font-medium text-gray-900">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-amber-500 shrink-0"></span>
<span class="truncate max-w-[150px] sm:max-w-none font-semibold">Baking Tool Kit BOM</span>
</div>
</td>
<td class="py-3 px-3">
<button class="font-mono text-gray-600 bg-gray-100 hover:bg-gray-200 px-1.5 py-0.5 rounded text-[11px] transition-colors" onclick="copySku(this, 'BOM-BAKE-01')" title="Click to copy SKU" type="button">
                      BOM-BAKE-01
                    </button>
</td>
<td class="py-3 px-3 text-center">
<span class="inline-flex items-center justify-center px-2.5 py-0.5 rounded-full text-xs font-bold bg-red-100 text-red-700 border border-red-200">
                      3
                    </span>
</td>
<td class="py-3 px-3 text-center font-medium text-gray-600 tabular-nums">
                    10
                  </td>
<td class="py-3 px-3 text-right text-gray-500 font-medium">
                    pcs
                  </td>
</tr>
<!-- Item 2 -->
<tr class="hover:bg-gray-50/50 transition-colors">
<td class="py-3 px-3.5 font-medium text-gray-900">
<div class="flex items-center gap-2">
<span class="w-2 h-2 rounded-full bg-red-600 shrink-0"></span>
<span class="truncate max-w-[150px] sm:max-w-none font-semibold">Journal Cover Sheet</span>
</div>
</td>
<td class="py-3 px-3">
<button class="font-mono text-gray-600 bg-gray-100 hover:bg-gray-200 px-1.5 py-0.5 rounded text-[11px] transition-colors" onclick="copySku(this, 'BOM-JRN-02')" title="Click to copy SKU" type="button">
                      BOM-JRN-02
                    </button>
</td>
<td class="py-3 px-3 text-center">
<span class="inline-flex items-center gap-1 justify-center px-2 py-0.5 rounded-full text-xs font-bold bg-red-600 text-white shadow-xs">
<span>0</span>
<span class="text-[9px] uppercase tracking-tighter font-semibold opacity-90">• Out of stock</span>
</span>
</td>
<td class="py-3 px-3 text-center font-medium text-gray-600 tabular-nums">
                    25
                  </td>
<td class="py-3 px-3 text-right text-gray-500 font-medium">
                    pcs
                  </td>
</tr>
</tbody>
</table>
</div>
</div>
<!-- 4. ACTION CARD -->
<div class="mt-2 rounded-xl bg-purple-50/80 border border-purple-100 p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3.5">
<div class="flex items-start gap-2.5">
<div class="w-8 h-8 rounded-lg bg-primary/10 text-primary flex items-center justify-center shrink-0 mt-0.5">
<span class="material-symbols-outlined" style="font-size: 19px;">inventory_2</span>
</div>
<p class="text-xs sm:text-sm text-gray-700 leading-snug font-medium">
              Please review and arrange replenishment at the earliest convenience.
            </p>
</div>
<a class="shrink-0 inline-flex items-center justify-center gap-1.5 px-4 py-2.5 bg-primary text-white rounded-lg text-xs font-semibold hover:bg-primary-container active:scale-[0.98] transition-all shadow-sm" href="#inventory">
<span>Review Inventory in Portal</span>
<span class="material-symbols-outlined" style="font-size: 16px;">arrow_forward</span>
</a>
</div>
</div>
</section>
<!-- 5. FOOTER -->
<footer class="w-full text-center py-3 px-4 flex flex-col items-center gap-1 text-gray-500 text-xs"><div class="flex items-center gap-1.5 font-medium text-gray-600"><span class="material-symbols-outlined text-gray-400" style="font-size: 15px;">lock_clock</span><span>Admin Portal • Fulfillment Desk • Ops Support</span></div><p class="text-[11px] text-gray-400">Swago Operations System • Automated Internal Alert</p><p class="text-[11px] text-gray-400">© 2026 Swago Jr. Internal Operations. Do not reply.</p></footer>
</main>
<script>
    function copySku(btn, sku) {
      if (navigator.clipboard) {
        navigator.clipboard.writeText(sku);
      }
      const original = btn.textContent;
      btn.textContent = 'Copied!';
      btn.classList.add('bg-purple-100', 'text-primary');
      setTimeout(() => {
        btn.textContent = original;
        btn.classList.remove('bg-purple-100', 'text-primary');
      }, 1200);
    }
  </script>


</body></html>