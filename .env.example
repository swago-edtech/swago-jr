# Example environment variables (no real values). Copy the keys you need into apps/web/.env.local.

# Address validation for checkout / COD / express orders.
#   enforce (default) – reject addresses whose postal code / city does not match the chosen state.
#   shadow            – accept those consistency mismatches but record the flag SHADOW_WOULD_REJECT on
#                       the order (missing/invalid state and missing required fields are still rejected).
#                       Use only for a short, monitored rollout window.
ADDRESS_VALIDATION_MODE=enforce

# Dev/load-test-only API routes (/api/test-auth, /api/test-order, /api/test-email,
# /api/test/add-swago-money). Disabled (404) unless this is "true" AND NODE_ENV is not
# "production". Never set this on production or staging servers that hold real data.
ENABLE_TEST_ROUTES=false

# Admin panel session signing secret (required in production; admin sign-in is refused without it).
ADMIN_JWT_SECRET=
