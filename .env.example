# Copy to .env / apps/web/.env.local / apps/admin/.env.local as needed.
# Never commit real values. Client bundles must not receive these secrets.

# Existing app secrets (already used; listed here only for context)
# MONGODB_URI=
# JWT_SECRET=
# ADMIN_JWT_SECRET=
# CRON_SECRET=

# Amazon SP-API (optional; all three required to enable Amazon seller API sync)
# AMAZON_SP_CLIENT_ID=
# AMAZON_SP_CLIENT_SECRET=
# AMAZON_SP_REFRESH_TOKEN=

# Flipkart self-access Seller API (optional; both required to enable Flipkart seller API sync)
# FLIPKART_APP_ID=
# FLIPKART_APP_SECRET=

# MSG91 dedicated email template ids (optional).
# When unset, sends use legacy wrapper template swagojr_order_confirmation2 + html_body.
# Paste HTML from templates/msg91/*.html into MSG91, then set the returned ids here.
# MSG91_TPL_ORDER_CONFIRMATION=
# MSG91_TPL_ADMIN_ORDER=
# MSG91_TPL_LOW_STOCK=
# MSG91_TPL_LOTTERY_WINNER=
# MSG91_TPL_SWAGO_MONEY=
