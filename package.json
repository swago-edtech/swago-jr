{
  "name": "swago-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Swago Jr. Monorepo - Main App and Admin Panel",
  "engines": {
    "node": ">=18.0.0",
    "pnpm": ">=8.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter web dev",
    "dev:web": "pnpm --filter web dev",
    "dev:admin": "pnpm --filter admin dev",
    "build": "pnpm build:web && pnpm build:admin",
    "build:web": "pnpm --filter web build",
    "build:admin": "pnpm --filter admin build",
    "start:web": "pnpm --filter web start",
    "start:admin": "pnpm --filter admin start",
    "lint": "pnpm --recursive run lint",
    "clean": "pnpm --recursive run clean && rm -rf node_modules",
    "type-check": "pnpm --recursive run type-check"
  },
  "devDependencies": {
    "@types/node": "^20.19.19",
    "@types/xlsx": "^0.0.36",
    "dotenv": "^17.2.3",
    "eslint": "^9",
    "mongoose": "^8.19.0",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "react": "19.1.0",
      "react-dom": "19.1.0",
      "next": "15.5.3"
    }
  },
  "dependencies": {
    "@next/third-parties": "^16.1.3",
    "openai": "^6.6.0",
    "recharts": "^3.4.1",
    "xlsx": "^0.18.5"
  }
}